{
  "name": "msms-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-School Management System — REST API (Node.js, Express, MySQL, Sequelize)",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "worker": "node src/jobs/worker.js",
    "cron": "node src/jobs/cron.js",
    "db:create": "node src/database/cli.js create",
    "db:migrate": "node src/database/cli.js migrate",
    "db:migrate:undo": "node src/database/cli.js migrate:undo",
    "db:seed": "node src/database/cli.js seed",
    "db:seed:undo": "node src/database/cli.js seed:undo",
    "db:seed:demo": "node src/database/cli.js seed:demo",
    "db:seed:demo:undo": "node src/database/cli.js seed:demo:undo",
    "db:migrate:status": "node src/database/cli.js migrate:status",
    "db:schema": "node src/database/cli.js schema",
    "db:reset": "node src/database/cli.js reset",
    "db:backup": "node src/jobs/tasks/databaseBackup.js",
    "db:restore-drill": "node scripts/restore-drill.js",
    "check:models": "node scripts/check-models.js",
    "test": "jest --runInBand",
    "test:baseline": "node scripts/record-baseline.js",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "mysql2": "^3.11.4",
    "nanoid": "^3.3.7",
    "node-cron": "^3.0.3",
    "nodemailer": "^9.0.5",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.15.1",
    "sequelize": "^6.37.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "<rootDir>/tests/globalSetup.js",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "maxWorkers": 1,
    "testTimeout": 60000,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/helpers/",
      "/tests/setup.js"
    ]
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
