# ─────────────────────────────────────────────────────────────────────────────
# Multi-School Management System — Backend environment
# SRS §27 "Environment Variables". Copy to .env and fill in real values.
# ─────────────────────────────────────────────────────────────────────────────

# Application
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
APP_NAME=Multi-School Management System
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
# Comma-separated CORS allow-list.
CORS_ORIGINS=http://localhost:3000
# Cap on a JSON / urlencoded request body. Files are bounded by MAX_UPLOAD_MB instead.
JSON_BODY_LIMIT=100kb

# Database (SRS §3 — MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=msms
DB_USER=root
DB_PASSWORD=
DB_POOL_MAX=15
DB_POOL_MIN=0
DB_LOGGING=false
DB_TIMEZONE=+00:00

# Test database (used when NODE_ENV=test)
DB_NAME_TEST=msms_test

# JWT (SRS §7, §24 "JWT Security")
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=msms
JWT_AUDIENCE=msms-api

# Passwords
BCRYPT_ROUNDS=12
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=48
# Minimum length for a new password. Length only — no composition rule; see config/env.js.
PASSWORD_MIN_LENGTH=8

# Login lockout. Complements the per-IP AUTH_RATE_LIMIT_MAX by bounding attempts per *account*.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Bootstrap Super Admin (created by the seeder)
SUPER_ADMIN_NAME=Platform Owner
SUPER_ADMIN_EMAIL=superadmin@msms.local
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=SuperAdmin@123

# Rate limiting (SRS §24)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_MAX=60
# Express "trust proxy". Empty/0 = the app is exposed directly (default).
# Behind one reverse proxy (nginx, a load balancer) set 1 so req.ip is the real client;
# also accepts loopback / a CIDR list. Never set `true` on a public deployment — it lets a
# caller forge X-Forwarded-For and mint themselves a fresh rate-limit quota per request.
TRUST_PROXY=

# Uploads (SRS §24 "File Upload security")
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_MB=10
# Absolute ceiling; a school's plan File Upload Limit may be lower and wins.

# Caching (SRS §25). Leave REDIS_URL empty to use the in-memory driver.
CACHE_DRIVER=memory
REDIS_URL=
CACHE_TTL_SECONDS=300

# Queue (SRS §25 "Queue system"). memory | database
QUEUE_DRIVER=memory
QUEUE_CONCURRENCY=3

# Mail (SRS §7 email verification, §23 notifications)
MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Multi-School Management System <no-reply@msms.local>"

# AI module (SRS §21). Provider-agnostic; "mock" needs no key and is used by tests.
AI_DRIVER=anthropic
AI_MODEL=claude-opus-5
ANTHROPIC_API_KEY=

# Payment gateways (SRS §13.2 — plugin based).
# Comma-separated list of enabled gateway keys.
PAYMENT_GATEWAYS=cash,bank_transfer,manual_payment,wallet,online_gateway
ONLINE_GATEWAY_KEY=online_gateway
ONLINE_GATEWAY_LABEL=Online Gateway
ONLINE_GATEWAY_API_KEY=
ONLINE_GATEWAY_SECRET=
ONLINE_GATEWAY_WEBHOOK_SECRET=

# Logging & monitoring (SRS §26)
LOG_LEVEL=info
LOG_DIR=storage/logs
LOG_RETENTION_DAYS=30
# Also log to stdout. Unset: on in development, off in production. Set true on a host whose only log
# view is stdout (Hostinger's Runtime logs).
LOG_CONSOLE=

# Backup (SRS §26 "Backup Retention")
BACKUP_DIR=storage/backups
BACKUP_RETENTION_DAYS=30
MYSQLDUMP_PATH=mysqldump

# Cron / scheduler
ENABLE_CRON=false
ENABLE_QUEUE_WORKER=false
# Run the scheduler inside the API instead of `npm run cron` — only on a host with one process per
# app (Hostinger web hosting). Never together with ENABLE_CRON.
CRON_IN_API=false
# Comma-separated task names to leave out of the schedule, e.g. database-backup where there is no mysqldump.
CRON_SKIP=

# Boot
# Apply pending migrations and the mandatory seed before the API listens. For hosts where nobody can
# run `npm run db:migrate` by hand (docs/DEPLOY-HOSTINGER.md). Idempotent, but off by default.
MIGRATE_ON_BOOT=false

# CSRF (applies to cookie-authenticated browser requests)
CSRF_ENABLED=true
CSRF_COOKIE_NAME=msms_csrf

# The httpOnly cookie the refresh token travels in (SRS §7 FR-AUTH-003).
REFRESH_COOKIE_NAME=msms_refresh
