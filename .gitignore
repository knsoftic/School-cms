.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Temporary
*.tmp
*.bak
tmp/

# The jest harness's raw run output — regenerated by globalSetup on every `npm test`.
# `tests/baseline.json` is NOT ignored: it is the recorded per-suite assertion count the run is
# checked against, and it only changes when `npm run test:baseline` is run deliberately.
backend/tests/.last-run.json
# The harness's run lock. Removed on a clean exit, so it only ever appears after a killed run — which is
# exactly when `git add -A` would sweep it into a commit.
backend/tests/.suite-run.lock
# Seeded-row captures written by suites that mutate seeded data, deleted once they have restored it.
# One found at a suite's start means a killed run never got that far — see scripts/lib/residue.js.
backend/tests/.journal/
frontend/tsconfig.tsbuildinfo
