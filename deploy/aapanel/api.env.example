# ─────────────────────────────────────────────────────────────────────────────────
# The API's environment on the aaPanel server. Guide: docs/DEPLOY-AAPANEL.md, step 7.
#
#   web app  https://school.knbazaar.com       folder /www/wwwroot/school.knbazaar.com
#   API      https://school-api.knbazaar.com   folder /www/wwwroot/school-api.knbazaar.com
#
# Copy this file to /www/wwwroot/school-api.knbazaar.com/backend/.env, fill in every
# blank, then `chmod 600` it. This file is committed, so it carries no real secret —
# every secret below is empty on purpose.
#
# The processes are started by deploy/aapanel/ecosystem.config.js, which sets
# NODE_ENV=production itself and gives the scheduler process its own ENABLE_CRON=true.
# ─────────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# aaPanel's reverse proxy for school-api.knbazaar.com points at http://127.0.0.1:4100.
# Not 4000: other Node apps on the same server commonly use it. Do NOT open this port in
# aaPanel → Security; only the web server should reach it.
PORT=4100
API_PREFIX=/api/v1
APP_NAME=Multi-School Management System

# Two subdomains of ONE domain (knbazaar.com). The sign-in cookie is SameSite=Lax, which a
# browser sends between these two and would NOT send between two unrelated domains.
# No trailing slash on any of these.
APP_URL=https://school-api.knbazaar.com
FRONTEND_URL=https://school.knbazaar.com
CORS_ORIGINS=https://school.knbazaar.com
JSON_BODY_LIMIT=100kb

# aaPanel → Databases → Add database. aaPanel does not prefix the names, so they are
# exactly what you typed. Leave the database empty: `npm run db:migrate` builds it.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=msms
DB_USER=msms
DB_PASSWORD=
DB_POOL_MAX=15
DB_POOL_MIN=0
DB_LOGGING=false
DB_TIMEZONE=+00:00
# Test suites only — nothing on this server reads it.
# DB_NAME_TEST=

# Two DIFFERENT random values of at least 32 characters. Generate each on the server with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=msms
JWT_AUDIENCE=msms-api

BCRYPT_ROUNDS=12
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=48
PASSWORD_MIN_LENGTH=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# The platform owner, created by `npm run db:seed`. Use your real email and a strong
# password for that run; the example value from backend/.env.example is refused in
# production. After you sign in and change it, empty SUPER_ADMIN_PASSWORD again (step 12)
# — the seed never changes an existing account's password, so it is not needed again.
SUPER_ADMIN_NAME=Platform Owner
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_MAX=60

# aaPanel's web server sits in front of the app. Without this every visitor looks like
# 127.0.0.1 to the rate limiter and the activity log. Never `true` — that lets a caller
# forge X-Forwarded-For.
TRUST_PROXY=1

# Outside both website folders, so nothing here can ever be served by the web server and a
# fresh clone cannot take student documents with it. Created in step 3, owned by msms.
UPLOAD_DIR=/www/msms-data/uploads
MAX_UPLOAD_MB=10

# One API process, so in-memory is correct. No Redis needed.
CACHE_DRIVER=memory
REDIS_URL=
CACHE_TTL_SECONDS=300
QUEUE_DRIVER=memory
QUEUE_CONCURRENCY=3

# A real mailbox. Production refuses MAIL_DRIVER=log — it would write password-reset links to
# a file and email nobody. Port 587 with MAIL_SECURE=false (STARTTLS), or 465 with
# MAIL_SECURE=true. Many VPS providers block port 25; do not use it.
MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
# Usually the same address as MAIL_USER — most SMTP servers only send as the signed-in mailbox.
# No surrounding quotes needed.
MAIL_FROM=Multi-School Management System <no-reply@example.com>

# SRS §21's question generator. Production refuses AI_DRIVER=anthropic without a key.
# If no plan you sell includes the AI module, AI_DRIVER=mock lets the API start without
# one — but mock answers with SAMPLE questions, so switch back to anthropic with a real
# key before any plan includes AI, or teachers will be handed made-up output.
AI_DRIVER=anthropic
AI_MODEL=claude-opus-5
ANTHROPIC_API_KEY=

# The payment METHODS offered. `online_gateway` is left out: this system ships no card
# processor (the SRS names none, so services/paymentGatewayService.js registers no adapter),
# and an online payment attempted without one is refused. Add it back only once a provider's
# adapter is registered and the three ONLINE_GATEWAY_* secrets below are set.
PAYMENT_GATEWAYS=cash,bank_transfer,manual_payment,wallet
ONLINE_GATEWAY_KEY=online_gateway
ONLINE_GATEWAY_LABEL=Online Gateway
ONLINE_GATEWAY_API_KEY=
ONLINE_GATEWAY_SECRET=
ONLINE_GATEWAY_WEBHOOK_SECRET=

LOG_LEVEL=info
# Outside the website folder, so the web server can never serve a log file. The scheduler's
# PM2 app writes to /www/msms-data/logs/cron instead, so the two never share a file.
LOG_DIR=/www/msms-data/logs
LOG_RETENTION_DAYS=30
# Off: PM2 already captures the console, and with this on every log line would be stored
# twice. Put LOG_CONSOLE=true in front of a single command to see its output (step 8).
LOG_CONSOLE=false

# The nightly backup (03:00, server time) runs mysqldump into this folder and keeps 30 days.
# aaPanel installs MySQL and MariaDB under /www/server/mysql. Check the path on your server
# with `ls /www/server/mysql/bin/mysqldump` (or `command -v mysqldump`) and correct it if needed.
BACKUP_DIR=/www/msms-data/backups
BACKUP_RETENTION_DAYS=30
MYSQLDUMP_PATH=/www/server/mysql/bin/mysqldump

# The scheduler is its own PM2 process (msms-cron), and ecosystem.config.js gives THAT process
# ENABLE_CRON=true. Keep it false here: every process reads this file, and a second scheduler
# started by hand would double every notification.
ENABLE_CRON=false
ENABLE_QUEUE_WORKER=false
# Hostinger-only settings — off here, where PM2 runs the scheduler and you migrate by hand.
CRON_IN_API=false
CRON_SKIP=
MIGRATE_ON_BOOT=false

CSRF_ENABLED=true
CSRF_COOKIE_NAME=msms_csrf
REFRESH_COOKIE_NAME=msms_refresh
