# ─────────────────────────────────────────────────────────────────────────────────
# The API's environment on Hostinger's managed Node.js hosting
# (Business web hosting, or any Cloud plan). Guide: docs/DEPLOY-HOSTINGER.md
#
# Paste these into hPanel → your API app → Environment variables, and fill in every
# blank. This file is committed, so it carries no real secret — every secret below is
# empty on purpose. Replace `u123456789` with your own account id and `example.com`
# with your domain throughout.
#
# For a VPS, use deploy/env/production.env.example instead: it runs the scheduler as
# its own PM2 process and migrates by hand, which this host cannot do.
# ─────────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# Not set. Hostinger chooses the port and hands it to the app; a PORT copied in here
# would override that choice and leave the proxy talking to nothing. The API falls
# back to 4000 only when nothing sets it.
# PORT=

API_PREFIX=/api/v1
APP_NAME=Multi-School Management System

# Two subdomains of ONE domain. The sign-in cookie is SameSite=Lax, which a browser
# sends between app.example.com and api.example.com (same site) and would NOT send
# between two unrelated domains — nobody would stay signed in.
APP_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
JSON_BODY_LIMIT=100kb

# hPanel → Databases → MySQL Databases. Hostinger prefixes the database and user
# with your account id; use the full names and the host that page shows.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_msms
DB_USER=u123456789_msmsuser
DB_PASSWORD=
# Business allows 75 connections per database user, shared by everything on the plan.
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_LOGGING=false
DB_TIMEZONE=+00:00
# Test suites only — nothing on this server reads it.
# DB_NAME_TEST=

# Two DIFFERENT random values of at least 32 characters. Generate each on your own
# computer with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=msms
JWT_AUDIENCE=msms-api

BCRYPT_ROUNDS=12
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=48
PASSWORD_MIN_LENGTH=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# The platform owner, created on the FIRST boot only. Set a strong password for that
# boot; the example value is refused in production. Once you have signed in and
# changed it, delete SUPER_ADMIN_PASSWORD from hPanel — the seed never changes an
# existing account's password, so it is not needed again.
SUPER_ADMIN_NAME=Platform Owner
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_MAX=60

# Hostinger's proxy sits in front of the app. Without this, every visitor looks like
# one client to the rate limiter and HTTPS is not detected.
TRUST_PROXY=1

# OUTSIDE the app folder. Hostinger overwrites the app's files on every deploy, so a
# relative path (the default, storage/uploads) would put student documents inside it
# and the next deploy would delete them. Your home path is in hPanel → File Manager.
# The folders are created on first use.
UPLOAD_DIR=/home/u123456789/msms-data/uploads
MAX_UPLOAD_MB=10

# No Redis on this hosting. In-memory is correct for one process.
CACHE_DRIVER=memory
REDIS_URL=
CACHE_TTL_SECONDS=300
QUEUE_DRIVER=memory
QUEUE_CONCURRENCY=3

# A mailbox from hPanel → Emails; the SMTP settings are under that mailbox's
# Configuration. Production refuses MAIL_DRIVER=log — it would write password-reset
# links to a file and email nobody.
MAIL_DRIVER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=no-reply@example.com
MAIL_PASSWORD=
MAIL_FROM="Multi-School Management System <no-reply@example.com>"

# SRS §21's question generator. Production refuses AI_DRIVER=anthropic without a key.
# If no plan you sell includes the AI module, AI_DRIVER=mock lets the API start without
# one — but mock answers with SAMPLE questions, so switch back to anthropic with a real
# key before any plan includes AI, or teachers will be handed made-up output.
AI_DRIVER=anthropic
AI_MODEL=claude-opus-5
ANTHROPIC_API_KEY=

PAYMENT_GATEWAYS=cash,bank_transfer,manual_payment,wallet,online_gateway
ONLINE_GATEWAY_KEY=online_gateway
ONLINE_GATEWAY_LABEL=Online Gateway
ONLINE_GATEWAY_API_KEY=
ONLINE_GATEWAY_SECRET=
ONLINE_GATEWAY_WEBHOOK_SECRET=

LOG_LEVEL=info
# Outside the app folder too, or the logs of the last deploy go with it.
LOG_DIR=/home/u123456789/msms-data/logs
LOG_RETENTION_DAYS=30
# hPanel's Runtime logs show the app's stdout and nothing else. Production writes its log
# only to LOG_DIR by default, so without this a healthy start shows an EMPTY runtime log
# and only a failure ever appears there.
LOG_CONSOLE=true

# Kept for completeness: database-backup is skipped below, because this hosting gives
# an app no mysqldump. Use hPanel → Files → Backups.
BACKUP_DIR=/home/u123456789/msms-data/backups
BACKUP_RETENTION_DAYS=30
MYSQLDUMP_PATH=mysqldump

# The scheduler runs INSIDE the API — renewals, invoices, overdue flags, fee fines,
# coupon and quotation expiry, notifications. There is no second process for it here.
# ENABLE_CRON stays false: it licenses a separate cron process, and production refuses
# the two together.
ENABLE_CRON=false
ENABLE_QUEUE_WORKER=false
CRON_IN_API=true
CRON_SKIP=database-backup

# Apply pending migrations and the mandatory seed before the API listens, on every
# start. This is how the empty database becomes the full schema on the first boot,
# and how a later release's migrations are applied. Safe to leave on.
MIGRATE_ON_BOOT=true

CSRF_ENABLED=true
CSRF_COOKIE_NAME=msms_csrf
REFRESH_COOKIE_NAME=msms_refresh
