# ─────────────────────────────────────────────────────────────────────────────────
# The web application's environment on Hostinger's managed Node.js hosting.
# Guide: docs/DEPLOY-HOSTINGER.md
#
# Paste into hPanel → your web app → Environment variables BEFORE the first deploy.
# ─────────────────────────────────────────────────────────────────────────────────

# server.js runs production unless this says `development` explicitly, so a missing
# value cannot put the live site on the dev server. Set it anyway.
NODE_ENV=production

# The API's public address, ending in /api/v1. Next.js compiles NEXT_PUBLIC_* values
# into the pages AT BUILD TIME, and on Hostinger web hosting the build does not happen
# in hPanel: GitHub Actions builds the `hostinger-frontend` branch, taking this value
# from the workflow's default or from a repository variable named NEXT_PUBLIC_API_URL
# (.github/workflows/hostinger-frontend.yml). Setting it here changes nothing in pages
# already built — change the repository variable and re-run the workflow instead.
# Kept here because a build from source (a VPS, or a local `npm run build`) reads it.
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1

# Not set, for the same reason as the API: Hostinger assigns the port, and server.js
# reads it. It falls back to 3000 only when nothing sets it.
# PORT=
